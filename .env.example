# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=development                # development | staging | production
APP_NAME=ReRush
APP_VERSION=0.1.0
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR

# ─── API Server ──────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKERS=1                          # Increase for production (e.g. 4)
RELOAD=true                        # Set to false in production

# ─── Supabase / PostgreSQL ────────────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct connection URL for SQLAlchemy (enables pgvector via asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:password@db.xxxx.supabase.co:5432/postgres

# ─── Embedding Model ──────────────────────────────────────────────────────────
# Model will be downloaded on first run (~90 MB for all-MiniLM-L6-v2)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384            # Must match the model output dimension
EMBEDDING_CACHE_DIR=.cache/models  # Local model cache path

# ─── TVmaze API ───────────────────────────────────────────────────────────────
TVMAZE_BASE_URL=https://api.tvmaze.com
TVMAZE_RATE_LIMIT_DELAY=0.2        # Seconds between requests (TVmaze allows ~20/s)

# ─── Search ───────────────────────────────────────────────────────────────────
DEFAULT_SEARCH_LIMIT=10
MAX_SEARCH_LIMIT=50
SIMILARITY_THRESHOLD=0.3           # Minimum cosine similarity score (0-1)
